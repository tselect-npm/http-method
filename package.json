{
  "name": "@tselect/http-method",
  "version": "1.0.0",
  "description": "HTTP methods related enums and utilities.",
  "keywords": [
    "http",
    "http-method",
    "method",
    "verb",
    "rest",
    "get",
    "post",
    "put",
    "patch",
    "delete",
    "enum",
    "typescript",
    "esm"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "cov": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm cov && pnpm build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tselect-npm/http-method.git"
  },
  "author": "Sylvain Estevez",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tselect-npm/http-method/issues"
  },
  "homepage": "https://github.com/tselect-npm/http-method#readme",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
